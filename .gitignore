# ===== DADOS DO USUÁRIO =====
# Tudo que o operador cria em runtime (estado, presets, escudos, fundos,
# mídias, torneios, CSVs) mora em dados/ — ver config.php.
# O repositório é só código: uma atualização (git pull, rsync) nunca toca aqui.
# A única exceção é o .htaccess, que protege os JSONs e fica versionado.
dados/*
!dados/.htaccess

# testes
tests/node_modules/
tests/frames/*
!tests/frames/.gitkeep

# ruído de editor/sistema
.DS_Store
Thumbs.db
*.swp
